{
  "name": "devprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub user/repo fingerprints for humans, plus agent-ready repo context packs.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^2.1.0"
  }
}
